{
  "name": "localkit",
  "productName": "LocalKit",
  "version": "0.4.0",
  "description": "Tu caja de herramientas local: imágenes, video, audio, PDF, transcripción y más. Nada sale de tu computadora.",
  "main": "out/main/index.js",
  "private": true,
  "author": "Codetria",
  "license": "MIT",
  "scripts": {
    "prepare:engine": "node scripts/copy-engine.mjs",
    "postinstall": "node scripts/copy-engine.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test \"test/unit/*.test.ts\"",
    "test:tools": "electron-vite build && node test/e2e/tools.mjs",
    "test:transcription": "electron-vite build && node test/e2e/transcription.mjs",
    "installer": "powershell -ExecutionPolicy Bypass -File installer/build.ps1"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "heic-decode": "^2.1.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@webgpu/types": "^0.1.74",
    "dompurify": "^3.4.17",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "highlight.js": "^11.12.0",
    "jsqr": "^1.4.0",
    "marked": "^18.1.2",
    "playwright": "^1.64.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FSichi/localkit.git"
  }
}
